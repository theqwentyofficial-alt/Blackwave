<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Blackwave_Optimizer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Blackwave_Optimizer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Blackwave.png"
        Title="Blackwave Optimizer"
        WindowDecorations="None"
        CanResize="False"
        Width="1280"
        Height="600"
        >

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

  <Grid>
      <Border Background="#0e0e0e">
          <Grid ColumnDefinitions="*" RowDefinitions="auto,*,auto">
              <Border CornerRadius="10" x:Name="dataBorder" BorderThickness="1" BorderBrush="#1A1A1A" Grid.Row="1" Margin="10" Background="#1e1e1e">
                  <Grid ColumnDefinitions="*,*,*" RowDefinitions="*">
                   <Border CornerRadius="10,0,0,10" Grid.Column="0" Background="#2A2A2A">
                       <Grid ColumnDefinitions="*" RowDefinitions="*,*,*">
                         <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*" Grid.Row="0">
                                 <TextBlock FontWeight="SemiBold" FontSize="24" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Column="1">
                                    CPU
                                </TextBlock>
                            </Grid>
                           <Grid Grid.Row="1">
                                <!-- Ellipse - Круг -->
                               <Ellipse Stroke="Gray" StrokeThickness="12" Width="180" Height="180">
                                   
                               </Ellipse>
                                 <!-- Arc - часть окружности -->
                               <Arc Stroke="Red" StartAngle="-90" SweepAngle="{Binding LoadInGraduses}" Width="180" Height="180" StrokeThickness="12" StrokeLineCap="Round">
                              <Arc.Transitions>
                                  <Transitions>
                                      <DoubleTransition Property="SweepAngle" Duration="0:0:0.4">
                                          
                                      </DoubleTransition>
                                  </Transitions>
                              </Arc.Transitions>      
                               </Arc>
                            
                      <TextBlock Text="{Binding Load}" Foreground="#FFFFFE" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    
                                </TextBlock>

                                   <TextBlock Foreground="#FFFFFE" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    Usage
                                </TextBlock>
                           </Grid>
                           <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*" Grid.Row="2">
                            <Border  Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="1" Grid.Column="0">
                               <TextBlock Text="{Binding ProcessorName}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                        
                            </TextBlock>   
                            </Border>
                             <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="1" Grid.Column="1">
                               <Grid ColumnDefinitions="*">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                   <TextBlock Text="Cores: " HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                
                               </TextBlock>   
                                   <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TotalCores}"/>
                                 
                              </StackPanel>
                                                   
                               </Grid>
                             </Border>
                              <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="2" Grid.Column="1">
                              <Grid ColumnDefinitions="*">
                                   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                       <TextBlock  Text="Threads: " HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                  
                               </TextBlock>    
                                     <TextBlock Text="{Binding TotalThreads}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                   
                               </TextBlock>    
                                   </StackPanel>
                              
                              </Grid>
                                 
                              </Border>
                                 <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="2" Grid.Column="0">
                             <Grid ColumnDefinitions="*">
                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                   <TextBlock Text="Current MHz: " TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                             
                               </TextBlock>
                                 <TextBlock Text="{Binding CurrentMhz}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                     
                                 </TextBlock>   
                                 </StackPanel>
                                  
                             </Grid>
                                   
                              </Border>
                               
                           </Grid>
                       </Grid>
                   </Border>
                   <Border Grid.Column="1" Background="#3A3A3A">
                        <Grid ColumnDefinitions="*" RowDefinitions="*,*,*">
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" Grid.Row="0">
                                 <TextBlock FontWeight="SemiBold" FontSize="24" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Column="1">
                                    GPU
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Row="1">
                           <Ellipse Width="180" Height="180" Stroke="Gray" StrokeThickness="12">
                               
                           </Ellipse>
                                <Arc StrokeLineCap="Round" StartAngle="-90" SweepAngle="240" Stroke="Green" Width="180" Height="180" StrokeThickness="12">
                                    <Arc.Transitions>
                                       <Transitions>
                                           <DoubleTransition Property="SweepAngle" Duration="0:0:0.4">
                                               
                                           </DoubleTransition>
                                       </Transitions>
                                    </Arc.Transitions>
                                </Arc>
                                 <TextBlock Foreground="#FFFFFE" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    52%
                                </TextBlock>
                                   <TextBlock Foreground="#FFFFFE" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    Usage
                                </TextBlock>
                            </Grid>
                             <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*" Grid.Row="2">
                            <Border  Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="1" Grid.Column="0">
                               <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                               Nvidia RTX GeForce 3050
                            </TextBlock>   
                            </Border>
                             <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="1" Grid.Column="1">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="Mem Free: " HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                 
                               </TextBlock>    

                              </StackPanel>
                                 
                             </Border>
                              <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="2" Grid.Column="1">
                               <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                   Mem Used:
                               </TextBlock>   
                              </Border>
                                 <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="2" Grid.Column="0">
                               <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                   Hot Spot: 36*
                               </TextBlock>   
                              </Border>
                               
                           </Grid>
                       </Grid>
                   </Border>
                     <Border CornerRadius="0,10,10,0" Grid.Column="2" Background="#4A4A4A">
                        <Grid ColumnDefinitions="*" RowDefinitions="*,*,*">
                              <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*" Grid.Row="0">
                                 <TextBlock FontWeight="SemiBold" FontSize="24" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Column="1">
                                    RAM
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Row="1">
                               
                                <Ellipse Width="180" Height="180" Stroke="Gray" StrokeThickness="12">
                                    
                                </Ellipse>
                                <Arc StrokeLineCap="Round" Stroke="Yellow" Width="180" StartAngle="-90" SweepAngle="{Binding RamLoadInGraduses}" Height="180" StrokeThickness="12">
                                   <Arc.Transitions>
                                      <Transitions>
                                          <DoubleTransition Property="SweepAngle" Duration="0:0:0.4">
                                              
                                          </DoubleTransition>
                                      </Transitions>
                                   </Arc.Transitions>
                                </Arc>
                                <TextBlock Text="{Binding RamLoad}" Foreground="#FFFFFE" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                   
                                </TextBlock>
                                   <TextBlock Foreground="#FFFFFE" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    Usage
                                </TextBlock>

                            </Grid>
                                <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*" Grid.Row="2">
                            <Border  Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="1" Grid.Column="0">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="Used: " TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                              
                            </TextBlock>        
                                  <TextBlock Text="{Binding RamUsed}">
                                      
                                  </TextBlock>
                              </StackPanel>
                              
                            </Border>
                             <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="1" Grid.Column="1">
                             <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                 <TextBlock Text="Available: " HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                               
                               </TextBlock>     
                                 <TextBlock Text="{Binding RamAvailable}">
                                     
                                 </TextBlock>
                              </StackPanel>
                                 
                             </Border>
                              <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="2" Grid.Column="1">
                             <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                 <TextBlock Text="Virtual Used: " HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                
                               </TextBlock>      
                                 <TextBlock Text="{Binding VirtRamUsed}">
                                     
                                 </TextBlock>
                              </StackPanel>
                                
                              </Border>
                                 <Border Margin="5" CornerRadius="5" Background="#CCCCCC" Grid.Row="2" Grid.Column="0">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                   <TextBlock Text="Virtual Available: " TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black">
                                 
                               </TextBlock>       
                                  <TextBlock Text="{Binding VirtRamAvailable}">
                                      
                                  </TextBlock>
                              </StackPanel>
                               
                                       
                              </Border>
                               
                           </Grid>
                       </Grid>
                   </Border>
                  </Grid>
              </Border>
              <Border Grid.Row="0" BorderThickness="2" BorderBrush="#2A2A2A" x:Name="topBorder" PointerPressed="OnPointerPressed" Height="40" Width="1280" MaxHeight="40" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#2e2e2e">
                <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="*">
                    
                    <TextBlock Grid.Column="2" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                    Blackwave
                 </TextBlock>      
                  <Button Command="{Binding HideCommand}" Foreground="White" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="4" Width="50" HorizontalAlignment="Right" Height="40">
                      hide
                  </Button>
                </Grid>
                </Border> 
              <Border Margin="0,10,0,10" Grid.Row="2" BorderThickness="2" BorderBrush="#2A2A2A" x:Name="bottomBorder" Width="1280" Height="50" Background="#2e2e2e" VerticalAlignment="Bottom">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                      <Button Command="{Binding SwitchToStatsCommand}" Foreground="White" FontSize="20" Background="Transparent">
                          Statistics
                      </Button>
                      <Button Command="{Binding SwitchToOptCommand}" Foreground="White" FontSize="20" Background="Transparent">
                          Optimizer
                      </Button>
                      <Button Command="{Binding ExitCommand}" Foreground="White" FontSize="20" Background="Transparent">
                          Exit
                      </Button>
                  </StackPanel>
              </Border>
          </Grid>
      </Border>
  </Grid>

</Window>
